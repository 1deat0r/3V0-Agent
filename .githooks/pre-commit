#!/usr/bin/env bash
# 3V0 pre-commit coherence guard — makes stale doctrine IMPOSSIBLE to merge.
#   1. A stale-doctrine phrase in the staged diff -> HARD BLOCK (reintroduction).
#   2. coherence --check (fail-close) has an open contradiction    -> HARD BLOCK.
#   3. Other tracked files are dirty (live-data excluded)          -> warn.
set -u
ROOT="$(git rev-parse --show-toplevel)"
PY="$ROOT/.venv/bin/python"; [ -x "$PY" ] || PY=python3

# 1) freshly-ADDED stale-doctrine phrases in DOC content == hard block.
#    Only scans added (+) lines in *.md/*.yaml/*.yml (docs), never the guard's
#    own definition lists (coherence.py/consistency.sh) or removed lines (cleanup).
PH='DeepSeek-v4-pro via the DeepSeek API only|never another provider|locks the model to DeepSeek-v4-pro|locks the reasoning engine to DeepSeek-v4-pro|approval stays on \.pro\.|the model to DeepSeek-v4-pro|Prime Directive \(immutable\): DeepSeek-v4-pro'
if git diff --cached -- '*.md' '*.yaml' '*.yml' | grep -E '^\+' | grep -nE "$PH" >/tmp/3v0_stale_scan.txt 2>/dev/null; then
  echo "PRE-COMMIT BLOCKED: staged changes *add* a stale-doctrine phrase:"
  head -20 /tmp/3v0_stale_scan.txt
  exit 1
fi

# 2) coherence fail-close (detect only; never lets auto-mutation sneak into a commit)
if ! (cd "$ROOT/3v0" && "$PY" -m core.coherence --check) >/tmp/3v0_coherence.txt 2>&1; then
  echo "PRE-COMMIT BLOCKED: coherence has open (fail-closed) contradictions:"
  tail -20 /tmp/3v0_coherence.txt
  exit 1
fi

# 3) warn (not block) on other dirty tracked files, excluding live data the
#    daemons write (memory.db, coalesce watermark)
DIRTY="$(git diff --name-only | grep -vE '3v0/data/memory\.db|coalesce\.watermark' || true)"
if [ -n "$DIRTY" ]; then
  echo "WARN: unstaged tracked changes left uncommitted:"
  echo "$DIRTY" | sed 's/^/  /'
fi
# 3b) rot guard — dead modules/deps/artifacts must not enter history.
#     Local gate replaces the CI job: it blocks reintroduction BEFORE the
#     bad commit exists, needs no token scope, and costs ~2s per commit.
#     --strict fails on dead-module candidates, dead deps, and artifacts;
#     informational lines (comments/TODO/duplicates) never block.
if ! timeout 300 "$PY" "$ROOT/scripts/rot_scan.py" --strict >/tmp/3v0_rot.txt 2>&1; then
  echo "PRE-COMMIT BLOCKED: rot_scan --strict found rot:"
  tail -25 /tmp/3v0_rot.txt
  exit 1
fi
# 4) wiki auto-sync — every commit must leave wiki == the exact staged tree.
#    The manifest is generated from `git ls-files`, so the commit boundary is
#    the correct sync point: a commit carries its own fresh wiki atomically.
#    --rebuild is idempotent (unchanged tree -> refreshed=0), so an in-sync
#    commit pays ~seconds; a stale one is fixed and re-staged automatically.
if ! "$PY" "$ROOT/scripts/build_wiki.py" --check >/tmp/3v0_wiki_pre.txt 2>&1; then
  echo "wiki: stale — auto-rebuilding and re-staging (in-sync commit)"
  if ! "$PY" "$ROOT/scripts/build_wiki.py" --rebuild >/tmp/3v0_wiki_rebuild.txt 2>&1; then
    echo "PRE-COMMIT BLOCKED: wiki rebuild failed:"
    tail -20 /tmp/3v0_wiki_rebuild.txt
    exit 1
  fi
  git add wiki/
fi

# Fail-close: even after a (possibly no-op) rebuild, the wiki must be at
# 100% coverage and contain no stale rows. A rebuild that can't reach that
# must block — the auto-sync must never silently paper over a real gap.
if ! "$PY" "$ROOT/scripts/build_wiki.py" --check >/tmp/3v0_wiki.txt 2>&1; then
  echo "PRE-COMMIT BLOCKED: wiki not at 100% coverage after auto-sync:"
  tail -20 /tmp/3v0_wiki.txt
  exit 1
fi
if [ -n "$(git diff --cached --name-only -- wiki/ | head -1)" ]; then
  echo "wiki: auto-synced $(git diff --cached --name-only -- wiki/ | wc -l) file(s) into this commit"
fi

exit 0